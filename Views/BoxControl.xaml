<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xslt2Game.BoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Canvas.Left="{x:Bind ViewModel.Left, Mode=OneWay}"
    Canvas.Top="{x:Bind ViewModel.Top, Mode=OneWay}">
    <Polyline Points="{x:Bind ViewModel.Points, Mode=OneWay}" 
              Stroke="{x:Bind ViewModel.Stroke, Mode=OneWay}" 
              StrokeThickness="{x:Bind ViewModel.StrokeThickness, Mode=OneWay}"
              Fill="{x:Bind ViewModel.Fill, Mode=OneWay}">
              
        <Polyline.RenderTransform>
            <RotateTransform Angle="{x:Bind ViewModel.BoxRotation, Mode=OneWay}" CenterX="0.5" CenterY="0.5"/>
        </Polyline.RenderTransform>
    </Polyline>
</UserControl>
