<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xslt2Game.Views.MoverControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Xslt2Game.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Canvas.Left="{x:Bind ViewModel.Left, Mode=OneWay}"
    Canvas.Top="{x:Bind ViewModel.Top, Mode=OneWay}">
    <Polyline Points="0.375,0.375 0.625,0.375 0.625,0.625 0.375,0.625" Fill="Black"/>
</UserControl>
