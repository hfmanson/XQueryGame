<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xslt2Game.Box"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Polyline Points="{x:Bind Points, Mode=OneWay}" Stroke="{x:Bind Foreground, Mode=OneWay}" StrokeThickness="{x:Bind StrokeThickness, Mode=OneWay}" Fill="{x:Bind Fill, Mode=OneWay}">
        <Polyline.RenderTransform>
            <RotateTransform Angle="{x:Bind BoxRotation, Mode=OneWay}" CenterX="0.5" CenterY="0.5"/>
        </Polyline.RenderTransform>
    </Polyline>
</UserControl>
