<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xslt2Game.Views.SmallBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Canvas.Left="{x:Bind ViewModel.Left, Mode=OneWay}"
    Canvas.Top="{x:Bind ViewModel.Top, Mode=OneWay}">
    <Polyline Points="0.225,0.225 0.225,0.8 0.8,0.8 0.8,0.225" 
              Stroke="{x:Bind ViewModel.Stroke, Mode=OneWay}" 
              StrokeThickness="0.075">

        <Polyline.RenderTransform>
            <RotateTransform Angle="{x:Bind ViewModel.BoxRotation, Mode=OneWay}" CenterX="0.5" CenterY="0.5"/>
        </Polyline.RenderTransform>
    </Polyline>
</UserControl>
